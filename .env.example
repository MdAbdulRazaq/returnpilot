# ─────────────────────────────────────────────────────────────
# ReturnPilot — environment variables
# Copy to `.env.local` and fill in. NEVER commit the filled file.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# ── Shopify (from your Partner app dashboard) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated scopes. Read-only is all we need.
SHOPIFY_SCOPES=read_orders,read_returns
# Shopify Admin API version we target
SHOPIFY_API_VERSION=2025-07

# ── Supabase ──
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC. Bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Token encryption ──
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Version stamped onto newly-encrypted tokens. Bump when you rotate the key.
TOKEN_ENCRYPTION_KEY_VERSION=1
# Optional. Decrypt-only keyring for rotation: JSON map of version → base64 key,
# e.g. {"1":"<old-base64-key>"}. Leave unset until you actually rotate.
TOKEN_ENCRYPTION_KEYS_RETIRED=

# ── Cron auth ──
# Random secret; Vercel Cron sends it as a Bearer token to protect /api/sync and /api/digest.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="ReturnPilot <alerts@yourdomain.com>"
# Email digest secret for verifying cron requests (used in /api/email/digest)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_DIGEST_SECRET=
